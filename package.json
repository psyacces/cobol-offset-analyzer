{
  "name": "cobol-offset-analyzer",
  "displayName": "COBOL Offset Analyzer",
  "description": "Hover over COBOL variables to instantly see their byte offset and length. Auto-active with toggle control. Perfect for analyzing complex COBOL data structures.",
  "version": "0.0.8",
  "publisher": "abraham-villeda",
  "repository": {
    "type": "git",
    "url": "https://github.com/psyacces/cobol-offset-analyzer"
  },
  "author": {
    "name": "Abraham Villeda",
    "email": "abraham.villeda@gmail.com"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cobol",
    "onCommand:cobol-offset.analyze"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cobol",
        "aliases": [
          "COBOL",
          "cobol"
        ],
        "extensions": [
          ".cbl",
          ".cob",
          ".cobol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "cobol-offset.analyze",
        "title": "COBOL Offset: Manually Trigger Analysis"
      },
      {
        "command": "cobol-offset.toggle",
        "title": "COBOL Offset: Toggle Active/Inactive"
      }
    ],
    "keybindings": [
      {
        "command": "cobol-offset.analyze",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorLangId == cobol"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./test/run-all.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.0.0"
  }
}
